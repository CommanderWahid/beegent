# Needed for search_explore.py's web_search()/fetch_page() (Tavily Search + Extract API).
# Required regardless of LLM_BACKEND - this is the search/fetch layer, not the LLM.
TAVILY_API_KEY=tvly-...

# Only needed when LLM_BACKEND=databricks
# DATABRICKS_HOST accepts either a bare hostname or the full https://... URL as shown
# in the Databricks UI - both are normalized before use.
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Model defaults for LLM_BACKEND=databricks are set in core/config.py
# (databricks-claude-sonnet-4-6 / databricks-claude-haiku-4-5 / databricks-claude-haiku-4-5 /
# databricks-claude-opus-5) - these are serving-endpoint names, not bare model names; verify
# with `GET /api/2.0/serving-endpoints` if your workspace names them differently.
# Override any of PLANNER_MODEL / SEARCH_EXPLORE_MODEL / TRIAGE_MODEL / CRITIC_MODEL here if needed.
