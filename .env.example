# Only needed when LLM_BACKEND=databricks
# DATABRICKS_HOST accepts either a bare hostname or the full https://... URL as shown
# in the Databricks UI - both are normalized before use.
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Model defaults live on the connector that owns them - see
# beegent/connectors/databricks.py and beegent/connectors/ollama.py. For Databricks these
# are serving-endpoint names, not bare model names; verify with
# `GET /api/2.0/serving-endpoints` if your workspace names them differently.
#
# Precedence, highest first:
#   CLI flag (--backend, --planner-model, --geofetch-model, --critic-model)
#   a real environment variable
#   this file
#   the connector's DEFAULT_MODELS
#
# Uncomment to pin a step. GEOFETCH_MODEL needs native function calling - it is the
# tool-calling agent, and the one that runs GEOFETCH_MAX_STEPS times per angle.
# LLM_BACKEND=databricks
# PLANNER_MODEL=
# GEOFETCH_MODEL=
# CRITIC_MODEL=
