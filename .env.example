# Only for the default backend (Ollama), and only to point somewhere other than localhost.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Only needed when LLM_BACKEND=mistral.
MISTRAL_API_KEY=...
# MISTRAL_BASE_URL=https://api.mistral.ai/v1   # only to point at a proxy

# Only needed when LLM_BACKEND=groq.
GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # only to point at a proxy

# Only needed when LLM_BACKEND=databricks; bare hostname or full https:// URL both work.
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Optional overrides - a CLI flag wins over these. See docs/configuration.md.
# Check the model names in the backend's docs.
# LLM_BACKEND=databricks|groq|ollama
# PLANNER_MODEL=
# GEOFETCH_MODEL=
# CRITIC_MODEL=

# Any integer setting in beegent/config.py, by its own name. See docs/configuration.md.
# MAX_ANGLES=1

# The web UI map preview. PREVIEW_DIR defaults next to BEEGENT_DB; empty disables previews.
# PREVIEW_DIR=
# PREVIEW_MAX_BYTES=50000000
# PREVIEW_TIMEOUT=120
# PREVIEW_CACHE_DAYS=7
