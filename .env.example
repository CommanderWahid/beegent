# Only needed when LLM_BACKEND=databricks
# DATABRICKS_HOST accepts either a bare hostname or the full https://... URL as shown
# in the Databricks UI - both are normalized before use.
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Model defaults for LLM_BACKEND=databricks are set in beegent/config.py
# (databricks-claude-sonnet-4-6 / databricks-claude-haiku-4-5 / databricks-claude-opus-5,
# for planner / geofetch / critic) - these are serving-endpoint names, not bare model names;
# verify with `GET /api/2.0/serving-endpoints` if your workspace names them differently.
# Override any of PLANNER_MODEL / GEOFETCH_MODEL / CRITIC_MODEL here if needed.
# GEOFETCH_MODEL needs native function calling - it is the tool-calling agent.
