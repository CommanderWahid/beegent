# Only needed when LLM_BACKEND=databricks; bare hostname or full https:// URL both work.
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Optional overrides - a CLI flag wins over these. See docs/configuration.md.
# Databricks model names are serving-endpoint names, not bare model names.
# LLM_BACKEND=databricks
# PLANNER_MODEL=
# GEOFETCH_MODEL=
# CRITIC_MODEL=
